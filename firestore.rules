rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isValidTimestamp(val) {
      return val is timestamp && val <= request.time;
    }

    function isValidUserProfile(data) {
      return data.email is string &&
             data.email.size() > 3 &&
             data.updatedAt is timestamp &&
             (!('displayName' in data) || data.displayName is string) &&
             (!('photoUrl' in data) || data.photoUrl is string) &&
             (!('createdAt' in data) || data.createdAt is timestamp);
    }

    function isValidCloudPlaylist(data, userId) {
      return data.id is string &&
             data.name is string &&
             data.name.size() > 0 &&
             data.name.size() <= 100 &&
             data.userId == userId &&
             data.updatedAt is timestamp &&
             (!('description' in data) || data.description is string) &&
             (!('tracksCount' in data) || data.tracksCount is int) &&
             (!('totalDurationMs' in data) || data.totalDurationMs is int) &&
             (!('tracksJson' in data) || data.tracksJson is string);
    }

    function isValidCustomPreset(data, userId) {
      return data.id is string &&
             data.name is string &&
             data.name.size() > 0 &&
             data.userId == userId &&
             data.updatedAt is timestamp &&
             (!('bandGains' in data) || data.bandGains is list) &&
             (!('bassBoost' in data) || data.bassBoost is number) &&
             (!('virtualizer3D' in data) || data.virtualizer3D is number) &&
             (!('reverbRoom' in data) || data.reverbRoom is string) &&
             (!('loFiPreset' in data) || data.loFiPreset is string);
    }

    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId) && isValidUserProfile(request.resource.data);
      allow delete: if isOwner(userId);

      match /playlists/{playlistId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidCloudPlaylist(request.resource.data, userId);
        allow delete: if isOwner(userId);
      }

      match /presets/{presetId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidCustomPreset(request.resource.data, userId);
        allow delete: if isOwner(userId);
      }
    }
  }
}
